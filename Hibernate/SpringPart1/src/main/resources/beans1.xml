<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="engine1" class="com.harsh.springcore.basics.model.Engine">
        <property name="engineName" value="BMW Motors"/> <!-- name should be same as property name defined in class -->
    </bean>
    <bean id="engine2" class="com.harsh.springcore.basics.model.Engine">
        <property name="engineName" value="JCB Automotive"/>
    </bean>

</beans>